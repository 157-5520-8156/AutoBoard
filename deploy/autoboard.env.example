TZ=Asia/Shanghai
AUTOBOARD_BASE_TOKEN=replace_with_task_base_app_token
AUTOBOARD_TASK_TABLE_ID=replace_with_task_table_id
AUTOBOARD_PROGRESS_TABLE_ID=replace_with_progress_table_id
AUTOBOARD_OWNER_TABLE_ID=replace_with_owner_table_id
AUTOBOARD_TASK_BOARD_URL=https://your-tenant.feishu.cn/base/replace_with_task_base_app_token
AUTOBOARD_DIARY_BOARD_URL=https://your-tenant.feishu.cn/base/replace_with_task_base_app_token
AUTOBOARD_JOURNAL_SCRIPT=/opt/autoboard/scripts/task-journal.mjs
AUTOBOARD_FINANCE_BASE_TOKEN=replace_with_finance_base_app_token_after_setup
AUTOBOARD_FINANCE_BASE_URL=https://your-tenant.feishu.cn/base/replace_with_finance_base_app_token
AUTOBOARD_FINANCE_BOARD_URL=https://your-tenant.feishu.cn/base/replace_with_finance_base_app_token
AUTOBOARD_FINANCE_SCRIPT=/opt/autoboard/scripts/financial-control.mjs
AUTOBOARD_FINANCE_SOURCE_TABLE_IDS=replace_with_comma_separated_finance_table_ids
AUTOBOARD_FINANCE_RECIPIENT_ALLOWLIST=replace_with_authorized_feishu_open_ids
AUTOBOARD_STATE_DIR=/var/lib/autoboard/.openclaw/workspace/state
AUTOBOARD_BACKUP_DIR=/var/backups/autoboard
